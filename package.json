{
  "name": "masked",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "check:tokens": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/check-tokens.mjs",
    "check:series": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/check-series.mjs",
    "check": "npm run typecheck && npm run check:tokens && npm run check:series && npm run check:fog && npm run check:errors && npm run check:preflight && npm run check:tape && npm run check:h2h",
    "sync:idl": "node -e \"const fs=require('fs');const i=JSON.parse(fs.readFileSync('chain/target/idl/fogduel.json','utf8'));fs.writeFileSync('src/chain/idl.ts','export const FOGDUEL_IDL = '+JSON.stringify(i,null,2)+';\\n\\nexport default FOGDUEL_IDL;\\n');console.log('idl synced')\"",
    "verify:client": "tsx scripts/verify-client.mts",
    "prove:privacy": "tsx scripts/prove-privacy.mts",
    "check:fog": "tsx scripts/check-fog.mts",
    "check:errors": "tsx scripts/check-errors.mts",
    "seed": "tsx scripts/seed-demo.mts",
    "check:preflight": "tsx scripts/check-preflight.mts",
    "open": "tsx scripts/open-matches.mts",
    "truth": "tsx scripts/chain-truth.mts",
    "cancel": "tsx scripts/cancel-open.mts",
    "check:sealed": "tsx scripts/check-sealed.mts",
    "check:pumpfun": "tsx scripts/check-pumpfun.mts",
    "check:markets": "tsx scripts/check-markets.mts",
    "check:gate": "tsx scripts/check-gate.mts",
    "proxy": "node server/market-proxy.mjs",
    "hold": "tsx scripts/hold-live.mts",
    "join": "tsx scripts/join-as.mts",
    "trade": "tsx scripts/trade-as.mts",
    "check:fog:wire": "tsx scripts/check-fog-wire.mts",
    "state": "tsx scripts/state.mts",
    "crank": "tsx scripts/crank-settle.mts",
    "check:vrf": "tsx scripts/check-vrf.mts",
    "check:tape": "tsx scripts/check-tape.mts",
    "check:h2h": "tsx scripts/check-h2h.mts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@expo-google-fonts/press-start-2p": "^0.2.3",
    "@expo-google-fonts/silkscreen": "^0.2.3",
    "@expo/metro-runtime": "~4.0.1",
    "@magicblock-labs/ephemeral-rollups-sdk": "^0.17.0",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-solflare": "^0.6.33",
    "@solana/web3.js": "^1.98.4",
    "buffer": "^6.0.3",
    "expo": "~52.0.0",
    "expo-constants": "~17.0.8",
    "expo-font": "~13.0.0",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.22",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-get-random-values": "^2.0.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "tsx": "^4.23.13",
    "typescript": "^5.3.3"
  }
}
